# ---- Copiez ce fichier en .env puis complétez ----
# Mode principal : Azure ADLS Gen2
LAKE_MODE=azure
LAKE_AUTH=key
AZURE_STORAGE_ACCOUNT=stumarketali01
AZURE_STORAGE_KEY=collez-ici-la-cle-key1
AZURE_TENANT_ID=collez-ici-l-id-du-tenant

# Mode secours (sans Azure) : décommentez et mettez LAKE_MODE=local
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=remplacez-par-une-cle-locale
# S3_SECRET_KEY=remplacez-par-un-secret-local

# Secret de pseudonymisation (TP 4) : une longue phrase que vous seul connaissez
PSEUDO_SECRET=changez-moi-par-une-phrase-longue-et-secrete

# Entrepôt PostgreSQL (TP 3)
POSTGRES_PASSWORD=remplacez-par-un-mot-de-passe-local
PG_URL=postgresql+psycopg://urban:remplacez-par-un-mot-de-passe-local@localhost:5432/urbanmarket
